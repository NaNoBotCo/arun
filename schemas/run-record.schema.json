{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARUN experiment run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "experimentId",
    "methodVersion",
    "dataStatus",
    "seed",
    "createdAt",
    "inputs",
    "metrics",
    "provenance",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "maxLength": 128
    },
    "experimentId": {
      "enum": [
        "E01",
        "E02",
        "E03",
        "E04",
        "E05",
        "E06",
        "E07",
        "E08",
        "E09",
        "E10",
        "E11",
        "E12",
        "E13",
        "E14",
        "E15",
        "E16",
        "E17",
        "E18",
        "E19",
        "E20",
        "E21"
      ]
    },
    "methodVersion": {
      "type": "string",
      "minLength": 1
    },
    "dataStatus": {
      "enum": [
        "MATHEMATICAL",
        "SYNTHETIC",
        "PUBLIC_HISTORICAL",
        "RESEARCH_MODEL",
        "AUTHORIZED_AGGREGATE"
      ]
    },
    "seed": {
      "type": "integer"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "inputs": {
      "type": "object",
      "description": "Experiment-specific allowlisted nonsensitive configuration; validate separately."
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "version",
          "license"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "resolution": {
            "type": "string"
          },
          "checksum": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "object",
      "description": "Allowlisted aggregate numerical diagnostics only; no logs or private payloads."
    },
    "elapsedMs": {
      "type": "number",
      "minimum": 0
    }
  }
}
